# CloudNova PaymentOps - environment configuration (EXAMPLE ONLY)
# Copy to .env for local development. NEVER commit .env.
# All values below are FAKE placeholders. Replace with real values in your environment.

# --- General ---
APP_ENV=development
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_DEBUG=false
APP_TIMEZONE=UTC

# --- API ---
API_TITLE=CloudNova PaymentOps
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=1

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated. A restrictive production value is preferred.
ALLOWED_HOSTS=localhost

# --- AI (non-authoritative; can be disabled) ---
AI_ENABLED=false
AI_PROVIDER=none            # none | ollama | vllm | custom
AI_BASE_URL=http://localhost:11434
AI_MODEL=none

# --- Database ---
# FAKE credentials only.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paymentops
DATABASE_USER=paymentops
DATABASE_PASSWORD=replace-me
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis / queue ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Observability ---
METRICS_ENABLED=true

# --- Processing (zero-retention is the default posture) ---
ZERO_RETENTION_ENABLED=true
# Seconds a raw payload may be held in memory before redaction. 0 = immediately.
RAW_PAYLOAD_TTL_SECONDS=0
